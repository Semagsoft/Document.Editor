/* Office 2010 Black Theme */
QMainWindow { background: #505050; }
QMenuBar { background: #585858; color: white; }
QMenuBar::item:selected { background: #6699ff; }
QToolBar { background: #585858; border: none; spacing: 4px; }
QToolButton { border: 1px solid transparent; border-radius: 3px; padding: 2px; color: white; }
QToolButton:hover { background: #6699ff; border-color: #4477dd; }
QToolButton:pressed, QToolButton:checked { background: #4477dd; }
QStatusBar { background: #585858; color: white; }
QMdiArea { background: #505050; }
QMenu { background: #444; border: 1px solid #666; color: white; }
QMenu::item:selected { background: #6699ff; }
